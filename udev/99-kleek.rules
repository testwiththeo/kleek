# Udev rules for kleek mouse companion daemon
# Grants non-root access to HID and evdev nodes for supported devices via uaccess/input

# Generic HID raw access for local seat user
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", TAG+="uaccess", MODE="0660", GROUP="input"

# Ensure uinput access for virtual mouse and smooth scrolling
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", MODE="0660", GROUP="input"
